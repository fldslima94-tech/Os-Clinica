rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security and validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return request.auth != null && (
        request.auth.token.email == 'fldslima94@gmail.com' ||
        (request.auth.token.keys().hasAll(['email_verified']) && request.auth.token.email_verified == true && request.auth.token.email == 'fldslima94@gmail.com')
      );
    }

    // Regras com acesso total para sincronização contínua do aplicativo
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

