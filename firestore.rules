rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Funções Auxiliares de Autenticação e RBAC
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['fldslima94@gmail.com', 'fabio@teste.com']
      );
    }

    // ==========================================
    // 0. HEALTH CHECK & CONEXÃO TESTE
    // ==========================================
    match /test/{testId} {
      allow read, write: if true;
    }

    // ==========================================
    // 1. CONFIGURAÇÕES DA CLÍNICA & PROCEDIMENTOS (Catálogo Público e Gestão)
    // ==========================================
    match /clinica_config/{configId} {
      allow read, write: if true;
    }

    match /clinicas/{clinicaId}/config/{configId} {
      allow read, write: if true;
    }

    match /procedimentos/{procedimentoId} {
      allow read, write: if true;
    }

    // ==========================================
    // 2. ORÇAMENTOS & PRÉ-AVALIAÇÕES
    // ==========================================
    match /solicitacoes_orcamento/{orcamentoId} {
      allow read, write: if true;
    }

    match /orcamentos_solicitacoes/{orcamentoId} {
      allow read, write: if true;
    }

    // ==========================================
    // 3. AGENDAMENTOS
    // ==========================================
    match /agendamentos/{agendamentoId} {
      allow read, write: if true;
    }

    // ==========================================
    // 4. PACIENTES & PRONTUÁRIOS
    // ==========================================
    match /pacientes/{pacienteId} {
      allow read, write: if true;
    }

    match /pacientes_portal/{perfilId} {
      allow read, write: if true;
    }

    match /fichas_clientes/{fichaId} {
      allow read, write: if true;
    }

    match /fichas_retorno/{fichaId} {
      allow read, write: if true;
    }

    // ==========================================
    // 5. USUÁRIOS & PERFIS DA EQUIPE
    // Hierarquia Estrita de Criação:
    // Apenas o Super Admin pode criar ou atribuir cargo de Super Admin (admin_master/admin_total).
    // Os demais usuários só podem criar apenas classe igual a sua ou inferior.
    // ==========================================
    match /usuarios/{usuarioId} {
      allow read: if true;
      allow create, update: if 
        !(request.resource.data.role in ['admin_total', 'admin_master']) ||
        !isAuthenticated() ||
        isSuperAdmin() ||
        request.resource.data.email in ['fldslima94@gmail.com', 'fabio@teste.com'];
      allow delete: if !isAuthenticated() || isSuperAdmin();
    }

    match /perfis/{perfilId} {
      allow read: if true;
      allow create, update: if 
        !(request.resource.data.role in ['admin_total', 'admin_master']) ||
        !isAuthenticated() ||
        isSuperAdmin() ||
        request.resource.data.email in ['fldslima94@gmail.com', 'fabio@teste.com'];
      allow delete: if !isAuthenticated() || isSuperAdmin();
    }

    // ==========================================
    // 6. FINANCEIRO & FLUXO DE CAIXA
    // ==========================================
    // Regra de Separação Financeira por Usuário:
    // - Saídas operacionais (tipo == 'saida') são unificadas para toda a clínica.
    // - Despesas recorrentes são unificadas para a gestão da clínica.
    // - Entradas e receitas são restritas: somente o usuário criador ou profissional atrelado pode visualizar/editar.
    // - Super Admin possui visibilidade global.
    match /transacoes/{transacaoId} {
      allow read: if !isAuthenticated() || isSuperAdmin() ||
        resource.data.tipo == 'saida' ||
        resource.data.usuario_id == request.auth.uid ||
        resource.data.criado_por_id == request.auth.uid ||
        resource.data.profissional_id == request.auth.uid;

      allow create: if true;

      allow update, delete: if !isAuthenticated() || isSuperAdmin() ||
        resource.data.usuario_id == request.auth.uid ||
        resource.data.criado_por_id == request.auth.uid ||
        resource.data.profissional_id == request.auth.uid;
    }

    match /fluxo_caixa/{fluxoId} {
      allow read, write: if true;
    }

    // Despesas recorrentes unificadas para toda a clínica
    match /despesas_recorrentes/{despesaId} {
      allow read, write: if true;
    }

    // ==========================================
    // 7. ESTOQUE & INSUMOS
    // ==========================================
    match /estoque/{insumoId} {
      allow read, write: if true;
    }

    match /estoque_insumos/{insumoId} {
      allow read, write: if true;
    }

    // ==========================================
    // 8. BENS & PATRIMÔNIO ATIVO
    // ==========================================
    match /bens/{bemId} {
      allow read, write: if true;
    }

    match /bens_ativos/{bemId} {
      allow read, write: if true;
    }

    // ==========================================
    // 9. FORNECEDORES & PARCEIROS
    // ==========================================
    match /fornecedores/{fornecedorId} {
      allow read, write: if true;
    }

    // ==========================================
    // 10. AVISOS & COMUNICAÇÃO INTERNA
    // ==========================================
    match /avisos/{avisoId} {
      allow read, write: if true;
    }

    match /comunicados_internos/{avisoId} {
      allow read, write: if true;
    }

    match /alertas_retorno/{alertaId} {
      allow read, write: if true;
    }

    // ==========================================
    // 11. MODELOS DE ANAMNESE & CONTRATOS
    // ==========================================
    match /modelos_anamnese/{modeloId} {
      allow read, write: if true;
    }

    match /modelos_contratos/{modeloId} {
      allow read, write: if true;
    }

    // ==========================================
    // 12. CONFIGURAÇÕES DE CAMPOS & SISTEMA
    // ==========================================
    match /configuracoes_campos/{configId} {
      allow read, write: if true;
    }

    match /configuracoes_sistema/{configId} {
      allow read, write: if true;
    }

    // ==========================================
    // 13. BACKUPS DO SISTEMA
    // ==========================================
    match /backups_sistema/{backupId} {
      allow read, write: if true;
    }

    // ==========================================
    // 14. INTEGRAÇÃO WHATSAPP (conversas, mensagens e pedidos recebidos)
    // ==========================================
    match /whatsapp_conversas/{telefone} {
      allow read, write: if true;
    }

    match /whatsapp_mensagens/{mensagemId} {
      allow read, write: if true;
    }

    match /pedidos_whatsapp/{pedidoId} {
      allow read, write: if true;
    }

    match /whatsapp_templates/{templateId} {
      allow read, write: if true;
    }

    // Bloqueio por padrão para qualquer outro caminho não declarado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
