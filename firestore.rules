rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES DE VALIDAÇÃO DEFENSIVAS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function perfilExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/perfis/$(request.auth.uid));
    }

    function getPerfilData() {
      return get(/databases/$(database)/documents/perfis/$(request.auth.uid)).data;
    }

    function getUserClinicaId() {
      return perfilExists() ? getPerfilData().get('clinicaId', '') : '';
    }

    function isSuperAdmin() {
      return perfilExists() && (
        getPerfilData().get('cargo', '') == 'admin_total' || 
        getPerfilData().get('role', '') == 'admin_total'
      );
    }

    function isMemberOf(clinicaId) {
      return isSuperAdmin() || (isAuthenticated() && getUserClinicaId() == clinicaId);
    }

    function isStaff(clinicaId) {
      return isSuperAdmin() || (
        isMemberOf(clinicaId) && 
        (getPerfilData().get('cargo', '') in ['admin_total', 'admin_local', 'gestor', 'recepcao', 'profissional', 'admin'] ||
         getPerfilData().get('role', '') in ['admin_total', 'admin_local', 'gestor', 'recepcao', 'profissional', 'admin'])
      );
    }

    // ==========================================
    // REGRAS POR COLEÇÃO (RAIZ)
    // ==========================================

    // 1. Perfis de Usuários
    match /perfis/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Usuários (alias de compatibilidade)
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // 2. Clínicas
    match /clinicas/{clinicaId} {
      allow read: if isAuthenticated();
      allow write: if isMemberOf(clinicaId);

      match /comunicados_internos/{comunicadoId} {
        allow read, write: if isStaff(clinicaId);
      }
    }

    // 3. Configurações de Campos (Ocultar/Exibir)
    match /configuracoes_campos/{configId} {
      allow read: if isAuthenticated();
      allow write: if isStaff(request.resource.data.clinicaId) || isSuperAdmin();
    }

    // Configurações da Clínica (alias)
    match /clinica_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isStaff(request.resource.data.clinicaId);
    }

    // 4. Despesas Recorrentes
    match /despesas_recorrentes/{despesaId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    // 5. Agendamentos
    match /agendamentos/{agendamentoId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId() ||
        resource.data.clienteId == request.auth.uid
      );
      allow write: if isAuthenticated() && (isStaff(request.resource.data.clinicaId) || isSuperAdmin());
    }

    // 6. Procedimentos
    match /procedimentos/{procId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    // 7. Fornecedores
    match /fornecedores/{fornecedorId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    // 8. Estoque e Insumos
    match /estoque_insumos/{insumoId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    match /estoque/{insumoId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    // 9. Fluxo de Caixa (Financeiro)
    match /fluxo_caixa/{lancamentoId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    match /transacoes/{transacaoId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    // 10. Fichas de Clientes e Pacientes
    match /fichas_clientes/{clienteId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);

      match /evolucoes_atendimentos/{evolucaoId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /pacientes/{pacienteId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    // 11. Bens e Ativos
    match /bens_ativos/{bemId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    match /bens/{bemId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.clinicaId == getUserClinicaId()
      );
      allow write: if isAuthenticated() && isStaff(request.resource.data.clinicaId);
    }

    // 12. Orçamentos e Solicitações
    match /orcamentos_solicitacoes/{orcamentoId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.usuarioClienteId == request.auth.uid ||
        resource.data.profissionalId == request.auth.uid ||
        resource.data.clinicaId == getUserClinicaId()
      );
      allow delete: if isSuperAdmin();
    }

    match /solicitacoes_orcamento/{orcamentoId} {
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.usuarioClienteId == request.auth.uid ||
        resource.data.profissionalId == request.auth.uid ||
        resource.data.clinicaId == getUserClinicaId()
      );
      allow delete: if isSuperAdmin();
    }

    // Modelos de Anamnese e Contratos
    match /modelos_anamnese/{modeloId} {
      allow read, write: if isAuthenticated();
    }

    match /modelos_contratos/{contratoId} {
      allow read, write: if isAuthenticated();
    }

    match /fichas_retorno/{fichaId} {
      allow read, write: if isAuthenticated();
    }

    match /avisos/{avisoId} {
      allow read, write: if isAuthenticated();
    }

    match /alertas_retorno/{alertaId} {
      allow read, write: if isAuthenticated();
    }
  }
}
